---
import { getCollection } from 'astro:content';
import Layout from '../../components/Layout.astro';
import TypedLede from '../../components/TypedLede.astro';
import SkillsMarquee from '../../components/SkillsMarquee.astro';
import PostCard from '../../components/PostCard.astro';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout
  title="Blog — Your Name"
  description="A short description of what you write about."
  canonicalPath="/blog/"
>
  <main class="content-shell">
    <section class="page-hero">
      <h1 class="visually-hidden">Blog</h1>
      <TypedLede text="A short description of what you write about." />
    </section>

    <section class="section" aria-label="Blog posts">
      {posts.length === 0 ? (
        <p style="color: var(--muted); font-family: var(--mono);">No posts yet, check back soon.</p>
      ) : (
        <div class="post-list">
          {posts.map((post, index) => <PostCard post={post} latest={index === 0} />)}
        </div>
      )}
    </section>

    <SkillsMarquee />
  </main>
</Layout>
