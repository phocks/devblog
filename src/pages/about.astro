---
import Layout from '../components/Layout.astro';
import TypedLede from '../components/TypedLede.astro';
import SkillsMarquee from '../components/SkillsMarquee.astro';
---

<Layout
  title="About — Your Name"
  description="A one-line summary of who you are and what you do."
  canonicalPath="/about/"
>
  <main class="content-shell" data-pagefind-body>
    <div class="page-hero">
      <h1 class="visually-hidden">About</h1>
      <TypedLede text="A one-line summary of who you are and what you do." />
    </div>

    <div class="section" style="max-width: var(--max);">
      <div class="about-grid">
        <div class="about-me">
          <div class="about-card">
            <h3>About</h3>
            <div class="about-prose">
              <p>Introduce yourself here. Say who you are, where you're based, and what kind of work you do. A couple of sentences is plenty for an opener.</p>
              <p>Use this paragraph for what you're working on right now: projects, interests, the tools you reach for most often.</p>
              <p>Close with what this site is for and how people can reach you. Replace the social links in the header with your own profiles.</p>
            </div>
          </div>
        </div>

        <aside>
          <div class="sidebar-card">
            <h3>Education</h3>
            <div class="edu-entry">
              <p class="edu-degree">Degree, Field of Study</p>
              <p class="edu-school"><a href="https://example.edu" target="_blank" rel="noopener" style="color: var(--accent);">University Name</a> · Year</p>
            </div>
            <div class="edu-entry">
              <p class="edu-degree">Degree, Field of Study</p>
              <p class="edu-school"><a href="https://example.edu" target="_blank" rel="noopener" style="color: var(--accent);">University Name</a> · Year</p>
            </div>

          </div>
        </aside>
      </div>
    </div>

    <SkillsMarquee />
  </main>
</Layout>
