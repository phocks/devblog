---
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<p class="hero-lede typed-lede">
  <span class="visually-hidden">{text}</span>
  <span class="typed-lede-target" aria-hidden="true">{text}</span>
</p>
<script is:inline data-astro-rerun>
  document.querySelectorAll('.typed-lede').forEach((wrap) => {
    if (wrap.dataset.typed) return;
    wrap.dataset.typed = '1';
    const target = wrap.querySelector('.typed-lede-target');
    if (!target) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const full = target.textContent || '';
    // Reserve the final height so the page doesn't shift while typing.
    wrap.style.minHeight = wrap.getBoundingClientRect().height + 'px';
    target.textContent = '';
    let i = 0;
    const tick = () => {
      if (!target.isConnected) return;
      i += 1;
      target.textContent = full.slice(0, i);
      if (i < full.length) {
        // setTimeout(tick, 26 + Math.random() * 38);
        setTimeout(tick, 1 + Math.random() * 1);
      } else {
        wrap.style.minHeight = '';
      }
    };
    setTimeout(tick, 200);
  });
</script>
